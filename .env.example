# 外部 Postgres（Docker Compose 将这些值传给 backend）
POSTGRES_HOST=172.17.0.1
POSTGRES_USER=upstreamhub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=upstreamhub
# 外部 Postgres 的监听端口
POSTGRES_PORT=5432

# 前端对外端口（容器内 backend 仍是 8418，nginx 已下线，前端直接由 Go 嵌入 serve）
UPSTREAMHUB_HTTP_PORT=8080

# Docker 镜像仓库和标签。生产流水线会自动更新服务器 .env 中的这两个值。
UPSTREAMHUB_IMAGE=worryzyy/upstream-hub
UPSTREAMHUB_IMAGE_TAG=latest

# Backend 运行模式 / 日志等级
UPSTREAMHUB_SERVER_MODE=release
UPSTREAMHUB_LOG_LEVEL=info

# 主密钥（任意长度，至少 32 字节随机串），用于 AES-GCM 加密敏感字段。
# **必填** — 修改后既有数据无法解密，请务必妥善保存。
APP_SECRET=please-change-me-to-a-long-random-secret-32bytes-min

# 鉴权开关。默认 false = 任何人访问 /api/* 都不需要登录（纯内网 / 反代后部署用）。
# 公网暴露请设 AUTH_ENABLED=true 并同时填好 ADMIN_PASSWORD。
AUTH_ENABLED=false

# 后台登录账号 / 密码。仅在 AUTH_ENABLED=true 时生效；AUTH_ENABLED=false 时可留空。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# token 签名密钥；留空时回退使用 APP_SECRET
AUTH_TOKEN_SECRET=
